<header class="site-document-header">
  <div class="site-document-header-inner">
    <a class="site-document-brand" href="/" aria-label="Steno home">
      <img src="/assets/steno-logo.svg" alt="Steno" width="71" height="25" />
    </a>
    <nav aria-label="Main navigation">
      <a href="/themes/">Themes</a>
      <a href="/plugins/">Plugins</a>
      <a href="/docs/">Docs</a>
      <button class="docs-search-trigger" type="button" data-search-open aria-label="Search docs">
        <span>Search docs</span>
        <kbd>⌘ K</kbd>
      </button>
    </nav>
    <div class="site-document-actions">
      <a class="github-icon" href={theme.githubUrl} aria-label="Steno on GitHub">
        <svg viewBox="0 0 24 24" width="21" height="21" fill="currentColor" aria-hidden="true">
          <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.26-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.39.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" />
        </svg>
      </a>
    </div>
  </div>
</header>
