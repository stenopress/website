<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="{description}" />
    <meta name="color-scheme" content="light dark" />
    <title>{title} | Steno Docs</title>
    <meta property="og:type" content="article" />
    <meta property="og:title" content="{title} | Steno Docs" />
    <meta property="og:description" content="{description}" />
    <meta property="og:image" content="/assets/steno-logo.svg" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="{title} | Steno Docs" />
    <meta name="twitter:description" content="{description}" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/assets/{assets?.['style.css']}" />
    <link rel="stylesheet" href="/assets/{assets?.['concept.css']}" />
    <script src="/assets/{assets?.['concept.js']}" defer></script>
  </head>
  <body class="docs-page">
    <header class="site-document-header">
      <div class="site-document-header-inner">
        <a class="site-document-brand" href="/" aria-label="Steno home"><img src="/assets/steno-logo.svg" alt="Steno" /></a>
        <nav aria-label="Main navigation">
          <a href="/themes/">Themes</a>
          <a href="/plugins/">Plugins</a>
          <a href="/docs/">Docs</a>
          <button class="docs-search-trigger" type="button" data-search-open><span>Search docs</span><kbd>⌘ K</kbd></button>
        </nav>
        <div class="site-document-actions">
          <a href={theme.githubUrl}>GitHub</a>
          <a class="site-document-cta" href={theme.jsrUrl}>View on JSR <span>↗</span></a>
        </div>
      </div>
    </header>
    <div class="docs-frame">
      <aside class="docs-sidebar">
        <nav aria-label="Documentation navigation">
          {#each data.docs_navigation as section}
            <strong>{section.label}</strong>
            {#each section.links as link}
              <a href={link.href}>{link.title}</a>
            {/each}
          {/each}
        </nav>
      </aside>
      <main class="docs-content">
        <article>{@html content}</article>
      </main>
      <aside class="docs-on-page" aria-label="On this page"><strong>On this page</strong><nav data-page-toc></nav></aside>
    </div>
    <dialog class="docs-search-dialog" data-search-dialog>
      <div class="search-panel">
        <div class="search-input-row"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m21 21-4.35-4.35m2.1-5.4a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z" /></svg><input type="search" placeholder="Search documentation" aria-label="Search documentation" data-search-input /><button type="button" data-search-close aria-label="Close search">Esc</button></div>
        <div class="search-results" data-search-results><p>Type to search guides, configuration, Tau, plugins, and API references.</p></div>
      </div>
    </dialog>
  </body>
</html>
