<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="{description}" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title} | Steno Docs</title>
    <meta property="og:type" content="article" />
    <meta property="og:title" content="{title} | Steno Docs" />
    <meta property="og:description" content="{description}" />
    <meta property="og:image" content="/assets/steno-logo.svg" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="{title} | Steno Docs" />
    <meta name="twitter:description" content="{description}" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/assets/{assets?.['style.css']}" />
    <link rel="stylesheet" href="/assets/{assets?.['website.css']}" />
    <script src="/assets/{assets?.['website.js']}" defer></script>
  </head>
  <body class="docs-page">
    <Header />
    <div class="docs-frame">
      <aside class="docs-sidebar">
        <nav aria-label="Documentation navigation">
          {#each data.docs_navigation as section}
            <div class="docs-nav-group">
              <strong>{section.label}</strong>
              {#each section.links as link}
                <a href={link.href}>{link.title}</a>
              {/each}
            </div>
          {/each}
        </nav>
      </aside>
      <main class="docs-content">
        <article>{@html content}</article>
      </main>
      <aside class="docs-on-page" aria-label="On this page"><strong>On this page</strong><nav data-page-toc></nav></aside>
    </div>
    <SearchDialog />
  </body>
</html>
