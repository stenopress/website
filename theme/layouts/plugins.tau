<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="{site.description}" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{#if title}{title} | {/if}{site.title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:title" content="{#if title}{title} | {/if}{site.title}" />
    <meta property="og:description" content="{site.description}" />
    <meta property="og:image" content="/assets/steno-logo.svg" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="{#if title}{title} | {/if}{site.title}" />
    <meta name="twitter:description" content="{site.description}" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" /></noscript>
    <link rel="stylesheet" href="/assets/{assets?.['style.css']}" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="/assets/{assets?.['website.css']}" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="/assets/{assets?.['style.css']}" />
      <link rel="stylesheet" href="/assets/{assets?.['website.css']}" />
    </noscript>
    <script src="/assets/{assets?.['site.js']}" defer></script>
    <script src="/assets/{assets?.['website.js']}" defer></script>
  </head>
  <body>
    <Header />
    <main class="docs-content page-content">
      <div class="landing-shell">
        <article>{@html content}</article>

        <div class="registry-section">
          <div class="registry-heading"><h2>Official</h2></div>
          <div class="choice-grid">
            {#each data.plugins.official as pkg}
            <article class="choice-card">
              <div class="choice-label"><span>{pkg.label}</span><small>{pkg.package}</small></div>
              <h3>{pkg.name}</h3>
              <p>{pkg.description}</p>
              <div class="mini-code"><code>{pkg.install}</code></div>
              <a class="card-source" href="{pkg.sourceUrl | url}">View source <span>↗</span></a>
            </article>
            {/each}
          </div>
        </div>

        <div class="registry-section">
          <div class="registry-heading">
            <h2>Community</h2>
            <a
              class="button-secondary"
              target="_blank"
              rel="noopener"
              title="Opens a prefilled file on GitHub - fill in the blanks and submit as a PR"
              href="https://github.com/stenopress/website/new/main?filename=registry/plugins/community/YOUR-PLUGIN-SLUG.yml&value=name%3A%20My%20Plugin%0Apackage%3A%20%22%40me%2Fplugin-my-plugin%22%0Alabel%3A%20Category%0Adescription%3A%20A%20one-sentence%20pitch%20for%20what%20the%20plugin%20does.%0Ainstall%3A%20%22jsr%3A%40me%2Fplugin-my-plugin%22%0AsourceUrl%3A%20https%3A%2F%2Fgithub.com%2Fme%2Fplugin-my-plugin%0A"
            >Add a community plugin</a>
          </div>
          <div class="choice-grid">
            {#each data.plugins.community as pkg}
            <article class="choice-card">
              <div class="choice-label"><span>{pkg.label}</span><small>{pkg.package}</small></div>
              <h3>{pkg.name}</h3>
              <p>{pkg.description}</p>
              <div class="mini-code"><code>{pkg.install}</code></div>
              <a class="card-source" href="{pkg.sourceUrl | url}">View source <span>↗</span></a>
            </article>
            {:else}
            <p class="registry-empty">No community plugins yet. <a href="/docs/plugins/">Write one</a> and open a PR to list it here.</p>
            {/each}
          </div>
        </div>

        <p><a href="/docs/plugins/">Write your own plugin →</a> · <a href="/docs/plugin_sandbox/">Read about the plugin sandbox →</a></p>
      </div>
    </main>
    <Footer />
    <SearchDialog />
  </body>
</html>
